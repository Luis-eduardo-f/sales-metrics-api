# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored and must never be committed with real secrets.

# SQLAlchemy connection string.
# Defaults to a local SQLite file when unset, so the API runs with zero
# external infrastructure. Swap for a Postgres URL in production/docker-compose:
#   postgresql+psycopg2://sales:sales@db:5432/sales_metrics
DATABASE_URL=sqlite:///./sales_metrics.db

# API key required in the `X-API-Key` header for all /metrics/* and
# /customers/* endpoints. Change this to a random value before deploying.
API_KEY=changeme

# TTL (in seconds) for the in-process revenue metrics cache.
CACHE_TTL_SECONDS=60
